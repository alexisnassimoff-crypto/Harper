# ---------- Airtable (obligatorio) ----------
# Personal Access Token: https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write, schema.bases:read
# Acceso: base "Harper"
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=appcFfhxM8uVdVKoP

# ---------- Sitio ----------
# OBLIGATORIA. Es la base de las back_urls y del notification_url que se le
# mandan a Mercado Pago: si no es una URL pública https, MP rechaza la
# preferencia y no se puede cobrar. Mientras harper.ar no esté conectado,
# tiene que ser el dominio de Vercel.
NEXT_PUBLIC_SITE_URL=https://harperar.vercel.app

# ---------- Mercado Pago ----------
# Las DOS son obligatorias para cobrar. Con el token pero sin el secreto se
# cobra la plata y ningún pedido llega a confirmarse: el webhook rechaza todas
# las notificaciones con 401, no baja el stock y no sale ningún mail.
# Panel > Tus integraciones > la aplicación > Credenciales de producción.
MP_ACCESS_TOKEN=APP_USR-...
# Panel > Webhooks > "Clave secreta". Se muestra UNA sola vez: guardala.
MP_WEBHOOK_SECRET=

# ---------- Resend (mails) ----------
# Sin esto se cobra igual, pero no sale NINGÚN mail: ni al cliente ni interno,
# y no queda registro fuera de los logs de Vercel.
# https://resend.com/api-keys
RESEND_API_KEY=re_...
# Tiene que ser del dominio verificado en Resend.
RESEND_FROM=Harper <pedidos@harper.ar>

# ---------- Vercel Blob (fotos y videos permanentes) ----------
# Vercel > Storage > Blob > Connect. Se agrega solo al vincular el store.
BLOB_READ_WRITE_TOKEN=

# ---------- Sincronización de media ----------
# Inventá una cadena larga al azar. La usa la automation de Airtable.
SYNC_TOKEN=
# Vercel lo manda solo en sus crons. Poné el mismo valor que SYNC_TOKEN.
CRON_SECRET=

# ---------- Correo Argentino (cotización de envíos) ----------
# Opcional: sin esto la tienda cobra el `costo_envio` plano de la tabla Config
# y sigue vendiendo igual. Con esto, el comprador paga el envío real a su CP.
# Alta y pedido de acceso a la API: correoargentino.com.ar/MiCorreo
CORREO_USER_TOKEN=
CORREO_PASSWORD_TOKEN=
# Mail y contraseña de la cuenta MiCorreo. Se usan para obtener el customerId.
CORREO_EMAIL=
CORREO_PASSWORD=
# "test" apunta a apitest.correoargentino.com.ar. Vacío = producción.
CORREO_MODO=

# ---------- Mercado Libre (importador de fotos) ----------
# Solo para traer fotos de las publicaciones. No interviene en el cobro.
# https://developers.mercadolibre.com.ar > Tus aplicaciones
ML_APP_ID=
ML_APP_SECRET=
